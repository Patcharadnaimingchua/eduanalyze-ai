# App
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database — Docker Postgres (docker-compose.yml), published on host port
# 5433 (not 5432) so it never collides with a pre-existing Homebrew
# Postgres install. POSTGRES_USER/POSTGRES_PASSWORD are also read directly
# by docker-compose.yml's postgres service (POSTGRES_DB is hardcoded to
# eduanalyze_ai there to match this).
DATABASE_URL="postgresql://eduanalyze:change_me_postgres_password@localhost:5433/eduanalyze_ai?schema=public"
POSTGRES_USER=eduanalyze
POSTGRES_PASSWORD=change_me_postgres_password

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth — register a real project in Google Cloud Console and
# replace these before using; non-empty placeholders only (passport's
# OAuth2Strategy throws at boot on an empty clientID).
GOOGLE_CLIENT_ID=change_me_google_client_id
GOOGLE_CLIENT_SECRET=change_me_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Email (SMTP) — used for forgot-password reset links and the
# "set your password" email sent when an ADMIN/SUPER_ADMIN creates a
# STAFF/INSTRUCTOR/ADMIN account (see EmailService). Gmail SMTP (free):
# host smtp.gmail.com, port 587. SMTP_PASS must be a Gmail "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords) —
# your normal Gmail password will be rejected, Google blocks plain SMTP
# auth on it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me@gmail.com
SMTP_PASS=change_me_gmail_app_password
SMTP_FROM=change_me@gmail.com

# AI Skill Analysis (§25-26) — Anthropic API, called live per request (no
# caching/persistence yet, see TODO.md). Replace with a real key before use.
ANTHROPIC_API_KEY=change_me_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
