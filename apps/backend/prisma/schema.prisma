// EduAnalyzeAI - Prisma Schema
// Models are added incrementally, one phase at a time, per the project roadmap.
// Phase 1: Organization Structure (Faculty -> Department -> Program -> Curriculum).
// Phase 2: User, Role, Scope Model (no auth logic yet — Phase 3).
// Phase 3: Authentication (Email+Password, Google OAuth). Password
// reset uses a separate token mechanism, added in its own later phase —
// not part of this schema. OTP (email verification) was part of the
// original design but removed later — see the migration that drops
// otp_codes for context.
// Phase 4: Curriculum Content (Course, Course Category, Curriculum
// Requirement, Prerequisite). CLO/PLO/Mapping/Achievement Threshold are
// out of scope — deferred to Phase 5.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Faculty {
  id        String   @id @default(uuid())
  name      String
  // No @unique here on purpose — same reason as StudentCourseRecord: Prisma
  // has no schema-level syntax for a filtered/partial unique index. The
  // real constraint is a partial unique index on (code) WHERE isActive =
  // true (see migration add_soft_delete_partial_unique_indexes) — a
  // soft-deleted faculty's code can be reused. `prisma migrate dev` cannot
  // see this index since it isn't declared here — always review with
  // --create-only, never auto-accept.
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  userScopes  UserScope[]

  @@map("faculties")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  programs   Program[]
  userScopes UserScope[]

  // No @@unique([facultyId, code]) here on purpose — see Faculty.code
  // comment above. Real constraint: partial unique index on (facultyId,
  // code) WHERE isActive = true.
  @@map("departments")
}

model Program {
  id        String   @id @default(uuid())
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  curricula       Curriculum[]
  userScopes      UserScope[]
  studentProfiles StudentProfile[]

  // No @@unique([departmentId, name])/@@unique([departmentId, code]) here
  // on purpose — see Faculty.code comment above. Real constraints: two
  // partial unique indexes, both WHERE isActive = true.
  @@map("programs")
}

model Curriculum {
  id                          String   @id @default(uuid())
  version                     String
  effectiveYear               Int
  totalCredits                Int
  isActive                    Boolean  @default(true)
  isOpenForRegistration       Boolean  @default(false)
  // Default Achievement Threshold (%) per PROJECT_CONTEXT.md §22 — a Clo
  // may override this via Clo.achievementThreshold; when null there, this
  // value applies.
  defaultAchievementThreshold Int      @default(70)
  // Semester Planning cap (§28) — default 22 is Kasetsart University
  // Kamphaeng Saen's rule, NOT a universal constant (§12/§24 require this
  // system stay generic across institutions) — override per curriculum
  // via PATCH as needed for other institutions/programs.
  maxCreditsPerSemester       Int      @default(22)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  studentProfiles StudentProfile[]
  categories      CourseCategory[]
  courses         Course[]
  requirements    CurriculumRequirement[]
  plos            Plo[]

  // No @@unique([programId, version]) here on purpose — see Faculty.code
  // comment above. Real constraint: partial unique index on (programId,
  // version) WHERE isActive = true.
  // @@unique([programId, id]) IS kept below — unlike the version
  // constraint, this one exists solely to support StudentProfile's
  // compound FK (references: [programId, id]), not soft-delete/natural-key
  // uniqueness. Do not remove it.
  @@unique([programId, id])
  @@map("curricula")
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String?
  fullName           String
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userRoles            UserRole[]
  scopes               UserScope[]
  studentProfile       StudentProfile?
  authMethods          UserAuthMethod[]
  pendingInvitation    PendingInvitation?
  passwordResetToken   PasswordResetToken?
  courseInstructor     CourseInstructor[]
  enteredCourseRecords StudentCourseRecord[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, role])
  @@map("user_roles")
}

model UserScope {
  id           String     @id @default(uuid())
  userId       String
  level        ScopeLevel
  facultyId    String?
  departmentId String?
  programId    String?
  createdAt    DateTime   @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program    Program?    @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@map("user_scopes")
}

model StudentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  studentCode   String   @unique
  programId     String
  curriculumId  String
  admissionYear Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  program    Program    @relation(fields: [programId], references: [id], onDelete: Restrict)
  curriculum Curriculum @relation(fields: [programId, curriculumId], references: [programId, id], onDelete: Restrict)

  courseRecords StudentCourseRecord[]
  assessments   CourseAssessment[]

  @@map("student_profiles")
}

enum Role {
  STUDENT
  INSTRUCTOR
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum ScopeLevel {
  FACULTY
  DEPARTMENT
  PROGRAM
}

model UserAuthMethod {
  id             String       @id @default(uuid())
  userId         String
  provider       AuthProvider
  providerUserId String?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, provider])
  @@unique([provider, providerUserId])
  @@map("user_auth_methods")
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

// Holds a not-yet-a-User Google identity while the client collects the
// remaining registration fields (studentCode/programId/curriculumId/
// admissionYear) that Google's callback can never provide. No relation to
// User — none exists yet when this row is created. Consumed (deleted) in
// the same transaction that finally creates the User.
model GooglePendingRegistration {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  email     String
  googleId  String
  fullName  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("google_pending_registrations")
}

// Gates password-setting for a User created by an ADMIN/SUPER_ADMIN via
// Module 12 (User Management). Unlike GooglePendingRegistration, the User
// row (plus its UserRole/UserScope) already exists with passwordHash:null
// when this is created — this row only proves who's allowed to set it.
// Consumed (deleted) by AuthService.acceptInvitation.
model PendingInvitation {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("pending_invitations")
}

// Gates password-reset for an existing User with a password already set —
// same token-hash+TTL shape as PendingInvitation, one active token per
// user (delete-then-recreate on repeat /auth/forgot-password calls, same
// pattern as PendingInvitationService.resend).
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("password_reset_tokens")
}

model CourseCategory {
  id        String   @id @default(uuid())
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)

  courses     Course[]
  requirement CurriculumRequirement?

  // No @@unique([curriculumId, name]) here on purpose — see Faculty.code
  // comment above. Real constraint: partial unique index on (curriculumId,
  // name) WHERE isActive = true.
  // @@unique([curriculumId, id]) IS kept below — unlike the name
  // constraint, this one exists solely to support Course's compound FK
  // (references: [curriculumId, id]), not soft-delete/natural-key
  // uniqueness. Do not remove it.
  @@unique([curriculumId, id])
  @@map("course_categories")
}

model Course {
  id          String   @id @default(uuid())
  code        String
  name        String
  nameEn      String?
  credits     Int
  description String?
  isRequired  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)

  categoryId String
  category   CourseCategory @relation(fields: [curriculumId, categoryId], references: [curriculumId, id], onDelete: Restrict)

  prerequisitesRequired Prerequisite[]        @relation("CoursePrerequisites")
  prerequisiteFor       Prerequisite[]        @relation("PrerequisiteForCourses")
  clos                  Clo[]
  studentRecords        StudentCourseRecord[]
  instructors           CourseInstructor[]
  assessments           CourseAssessment[]

  // No @@unique([curriculumId, code]) here on purpose — see Faculty.code
  // comment above. Real constraint: partial unique index on (curriculumId,
  // code) WHERE isActive = true.
  @@map("courses")
}

model CurriculumRequirement {
  id         String   @id @default(uuid())
  minCredits Int
  minCourses Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)

  categoryId String         @unique
  category   CourseCategory @relation(fields: [curriculumId, categoryId], references: [curriculumId, id], onDelete: Restrict)

  @@unique([curriculumId, categoryId])
  @@map("curriculum_requirements")
}

// courseId/prerequisiteCourseId both reference Course — a self-relation
// via two named relations. groupId is null for a plain AND requirement
// (every row for a given courseId must be satisfied); rows sharing the
// same non-null groupId will represent an OR group ("pass at least one")
// once that checker logic is built — no migration needed to add that,
// the column is already here.
model Prerequisite {
  id                   String   @id @default(uuid())
  courseId             String
  prerequisiteCourseId String
  groupId              String?
  createdAt            DateTime @default(now())

  course             Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Restrict)
  prerequisiteCourse Course @relation("PrerequisiteForCourses", fields: [prerequisiteCourseId], references: [id], onDelete: Restrict)

  @@unique([courseId, prerequisiteCourseId])
  @@map("prerequisites")
}

// Assigns a User (INSTRUCTOR role) to a Course — many-to-many, co-teaching
// supported. Hard-delete: a pure assignment gate with no accumulated
// calculation value, same CONVENTIONS.md §7 reasoning as Prerequisite,
// unlike Course/CloPloMapping which are soft-delete because they
// parameterize reproducible calculations.
model CourseInstructor {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@map("course_instructors")
}

// Program Learning Outcome — scoped to Curriculum (not Program), since a
// curriculum revision may also revise its PLOs. PROJECT_CONTEXT.md §20:
// the count/detail of PLOs is program-specific (IT currently has 6) and
// must never be hardcoded.
model Plo {
  id          String   @id @default(uuid())
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)

  cloMappings CloPloMapping[]

  // No @@unique([curriculumId, code]) here on purpose — see Faculty.code
  // comment above. Real constraint: partial unique index on (curriculumId,
  // code) WHERE isActive = true.
  @@map("plos")
}

// Course Learning Outcome — scoped to Course. achievementThreshold is an
// optional per-CLO override (%); when null, Curriculum.defaultAchievementThreshold
// applies (PROJECT_CONTEXT.md §22).
model Clo {
  id                   String   @id @default(uuid())
  code                 String
  description          String
  achievementThreshold Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  ploMappings      CloPloMapping[]
  assessmentScores CourseAssessmentCloScore[]

  // No @@unique([courseId, code]) here on purpose — see Faculty.code
  // comment above. Real constraint: partial unique index on (courseId,
  // code) WHERE isActive = true.
  @@map("clos")
}

// CLO-PLO many-to-many with weight (PROJECT_CONTEXT.md §21). Soft-delete
// (unlike Prerequisite) — see CONVENTIONS.md §7 note: this mapping
// directly parameterizes Achievement/PLO % calculations that feed Radar
// Charts and trend analytics, so hard-deleting it would make past
// dashboard values unreproducible.
model CloPloMapping {
  id        String   @id @default(uuid())
  weight    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cloId String
  clo   Clo    @relation(fields: [cloId], references: [id], onDelete: Restrict)

  ploId String
  plo   Plo    @relation(fields: [ploId], references: [id], onDelete: Restrict)

  @@unique([cloId, ploId])
  @@map("clo_plo_mappings")
}

// Student self-assessment against a Course's CLOs (1-5 scale), separate
// from Grade-based Achievement — PROJECT_CONTEXT.md §27 is explicit these
// must stay distinct (Objective/Academic Indicator = Grade-based,
// Perception/Self Assessment = this). One submission per
// (studentProfileId, courseId), editable afterward — not a history table.
model CourseAssessment {
  id        String   @id @default(uuid())
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  cloScores CourseAssessmentCloScore[]

  @@unique([studentProfileId, courseId])
  @@map("course_assessments")
}

// Cascade-deleted with its parent CourseAssessment — unlike every other
// onDelete:Restrict relation in this schema, these rows have no
// independent existence or value outside their submission; PATCH replaces
// the whole set in one transaction (delete all + recreate), not per-CLO.
model CourseAssessmentCloScore {
  id    String @id @default(uuid())
  score Int // 1-5, enforced by DTO @Min(1)/@Max(5) — no DB-level CHECK constraint used elsewhere in this schema

  courseAssessmentId String
  courseAssessment   CourseAssessment @relation(fields: [courseAssessmentId], references: [id], onDelete: Cascade)

  cloId String
  clo   Clo    @relation(fields: [cloId], references: [id], onDelete: Restrict)

  @@unique([courseAssessmentId, cloId])
  @@map("course_assessment_clo_scores")
}

// Global master data (not scoped to Program/Curriculum) — shared across
// the whole university, per PROJECT_CONTEXT.md §16. Year is Buddhist Era
// (พ.ศ.), same convention as Curriculum.effectiveYear.
model AcademicYear {
  id        String   @id @default(uuid())
  year      Int      @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters Semester[]

  @@map("academic_years")
}

enum SemesterTerm {
  FIRST
  SECOND
  SUMMER
}

model Semester {
  id        String       @id @default(uuid())
  term      SemesterTerm
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  records StudentCourseRecord[]

  // No @@unique([academicYearId, term]) here on purpose — see Faculty.code
  // comment above. Real constraint: partial unique index on
  // (academicYearId, term) WHERE isActive = true.
  @@map("semesters")
}

// Thai 8-level scale (A .. F) plus special grades (W/I/S/U). Grade-point
// mapping is a fixed national-standard constant, hardcoded in
// StudentCourseRecordService rather than a DB lookup table — see
// CONVENTIONS.md discussion in Phase 6 planning.
enum Grade {
  A
  B_PLUS
  B
  C_PLUS
  C
  D_PLUS
  D
  F
  W
  I
  S
  U
}

// Self-reported by the student (PROJECT_CONTEXT.md §16 — no REG
// integration). credits is a snapshot of Course.credits at the time this
// record was created, not a live join — protects the student's own
// historical record from being changed by an unrelated later edit to the
// course catalog. Hard-delete: §16 frames removal as the student
// correcting a mis-entered row, not something requiring an audit trail.
model StudentCourseRecord {
  id        String   @id @default(uuid())
  grade     Grade
  credits   Int
  // Soft-delete only applies to ADMIN/STAFF removing a record that isn't
  // theirs (higher risk than a student correcting their own mis-entry) —
  // see StudentCourseRecordService.remove(). STUDENT-self/SUPER_ADMIN
  // deletes stay hard, unchanged.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit trail (§10 STAFF write access made this necessary) — last
  // writer, not first: overwritten on both create and update, answering
  // "who is responsible for the record's current state." Nullable
  // because existing rows predate this field — NULL honestly means
  // "unknown/legacy", never backfilled with a guessed value. New rows are
  // always populated by the service layer.
  enteredByUserId String?
  enteredBy       User?   @relation(fields: [enteredByUserId], references: [id], onDelete: Restrict)
  // Reuses the existing Role enum rather than a parallel STUDENT_SELF/
  // STAFF_ON_BEHALF concept — Role.STUDENT here already means self-entry.
  enteredByRole   Role?

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  // No @@unique here on purpose — Prisma has no schema-level syntax for a
  // filtered/partial unique index. The real constraint enforced in
  // Postgres is a partial unique index on (studentProfileId, courseId,
  // semesterId) WHERE isActive = true (see migration
  // add_student_course_record_partial_unique_index) — soft-deleted rows
  // no longer occupy the slot. `prisma migrate dev` cannot see this index
  // since it isn't declared here, and may propose dropping it as drift —
  // always review with --create-only, never auto-accept.
  @@map("student_course_records")
}
